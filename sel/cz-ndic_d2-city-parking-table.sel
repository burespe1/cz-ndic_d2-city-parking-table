        </D2Litteral>
        <D2Litteral>
          <name>motorwayParking</name>
          <definition>The parking is located directly on a motorway or a similar type of road.</definition>
          <order>10</order>
          <generate>false</generate>
          <ID>EAID_71AC71FD_64AA_42e8_8315_DFDD35625E55</ID>
        </D2Litteral>
        <D2Litteral>
          <name>nearbyMotorwayParking</name>
          <definition>The parking is located with some distance to a motorway or a similar type of road but focussed on travellers from this motorway.</definition>
