        </D2Litteral>
        <D2Litteral>
          <name>eventParking</name>
          <definition>Parking is associated with an event. Use 'eventParkingType' to specify the event.</definition>
          <order>6</order>
          <generate>true</generate>
          <ID>EAID_6F802A93_8708_4461_BF0D_A71377A966F3</ID>
        </D2Litteral>
        <D2Litteral>
          <name>guidanceToAvailableSpaces</name>
          <definition>Specifies, if there is a (visual) guidance system within the parking site, which helps the drivers to find free spaces. Note: This is not a parking VMS or a parking route, which are usually located outside the parking site.</definition>
          <order>7</order>
          <generate>true</generate>
          <ID>EAID_2919E30E_B37A_469f_AA08_0024A30A086B</ID>
