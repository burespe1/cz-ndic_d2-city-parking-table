          <generate>false</generate>
          <ID>EAID_D9ECF222_E7EA_4ede_81E6_3F20132B8C9F</ID>
        </D2Litteral>
        <D2Litteral>
          <name>overnightParking</name>
          <definition>The parking site or space(s) are designed for overnight parking. Note that the absence of this scenario does not automatically mean a prohibition of overnight parking. See also PermitsAndProhibitions.</definition>
          <order>12</order>
          <generate>true</generate>
          <ID>EAID_125897A3_6717_4b68_843E_6156EC757F8E</ID>
