          <definition>Parking site with possibility for very short parking to drop off (or drop on) passengers for public transport.</definition>
          <order>8</order>
          <generate>true</generate>
          <ID>EAID_9393925B_290C_4633_B143_EDCEDB386012</ID>
        </D2Litteral>
