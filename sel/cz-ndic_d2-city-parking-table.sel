      </package>
      <NamespaceName>Parking</NamespaceName>
      <d2Litteral>
        <D2Litteral>
          <name>automatedParkingGarage</name>
          <definition>Parking is completely automated from the point of leaving the vehicle in an arrival bay to its delivery back to the driver in a pickup bay.</definition>
          <order>0</order>
